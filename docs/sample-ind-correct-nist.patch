+
+# ---------------------------------------------------------------- full-reading NIST diagnostics (once per export)
+# Requires the NIST addition in the adjacent lsh-lock checkout, NumPy and official ea_non_iid.
+# The default face input matches the deduplicated entropy suite above; g_build creates it.
+# Change NIST_TAG for a new input/configuration; existing successful jobs are skipped.
+g_nist() {
+  local nist_repo=${NIST_LSH_ROOT:-../lsh-lock}
+  local nist_python=${NIST_PYTHON:-python3}
+  local tag=${NIST_TAG:-full}
+  run nist_$tag "$nist_python" "$nist_repo/scripts/nist_datasets.py" \
+      --data-root "$D" --face-templates "${NIST_FACE:-$FACED}" \
+      --output-root "$OUT/nist_$tag" --nist-bin "${NIST_EA_NON_IID:-ea_non_iid}" \
+      --trials "${NIST_TRIALS:-1000}" --seed "${NIST_SEED:-67}" \
+      --jobs "${NIST_JOBS:-1}" --timeout "${NIST_TIMEOUT:-180}"
 }
 
